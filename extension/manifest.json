{
  "manifest_version": 3,
  "name": "GemmaPilot",
  "version": "0.1.0",
  "description": "Your browser co-pilot. GemmaPilot reads your current tab and acts on it with Gemma (via Ollama) — and always checks with you before anything you can't undo.",
  "permissions": ["sidePanel"],
  "host_permissions": ["http://localhost:8765/*", "http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open GemmaPilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
