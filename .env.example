# Copy to .env and edit as needed (all optional — defaults work out of the box).
# The backend reads these at startup.

# Model served by Ollama. *-cloud tags run on Ollama Cloud (needs `ollama
# signin`, or an API key below). Use a local tag (e.g. gemma4:e2b) to stay
# fully on-device with no auth.
OLLAMA_MODEL=gemma4:31b-cloud

# Local daemon (proxies cloud tags after `ollama signin`), OR set this to
# https://ollama.com together with OLLAMA_API_KEY for direct Cloud access.
OLLAMA_BASE_URL=http://localhost:11434

# Only needed for direct Cloud access (OLLAMA_BASE_URL=https://ollama.com).
# Get one at https://ollama.com/settings/keys . Leave empty when using a
# signed-in local daemon.
OLLAMA_API_KEY=

# Chrome remote-debugging endpoint that Playwright attaches to over CDP.
CDP_ENDPOINT=http://localhost:9222

# Backend server.
AGENT_HOST=127.0.0.1
AGENT_PORT=8765

# Agent loop guardrails.
AGENT_MAX_STEPS=15
AGENT_MAX_PAGE_NODES=120
